<%= form_with model: question do |form| %>
  <% if question.errors.any? %>
    <div class="form-errors mb-sm">
      <% question.errors.each do |error| %>
        <p class="form-error"><%= error.full_message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.text_field :title,
        class: "form-input",
        placeholder: "Title (clean typography)" %>
  </div>

  <div class="form-group">
    <%= form.text_area :body,
        rows: 4,
        class: "form-text-area",
        placeholder: "Describe your question in detail..." %>
  </div>

  <div class="form-group">
    <%= form.text_field :tags,
        class: "form-input",
        placeholder: "Tags: React, NextJS, Postgres (comma-separated)" %>
  </div>

  <%= form.button type: :submit, class: "btn-publish" do %>
    Publish Question <%= fa_icon "rocket" %>
  <% end %>
<% end %>
