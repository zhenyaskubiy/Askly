<div class="question-card">
  <div class="question-card-header">
    <div class="question-card-author">
      <div class="avatar-circle" style="background-color: <%= avatar_bg(question.user) %>">
        <%= user_initials(question.user) %>
      </div>
      <div class="author-info">
        <span class="author-name"><%= question.user.nickname %></span>
        <span class="author-time"><%= time_ago_in_words(question.created_at) %> ago</span>
      </div>
    </div>
    <% if current_user == question.user %>
      <div style="display:flex;gap:6px;align-items:center;">
        <%= link_to edit_question_path(question), class: "btn-action" do %>
          <%= fa_icon "pencil" %>
        <% end %>
        <%= button_to question_path(question), method: :delete,
            class: "btn-action",
            form: { data: { turbo_confirm: "Delete this question?" } } do %>
          <%= fa_icon "trash" %>
        <% end %>
      </div>
    <% else %>
      <button class="question-menu-btn"><%= fa_icon "ellipsis-h" %></button>
    <% end %>
  </div>

  <% if question.title.present? %>
    <div class="question-title">
      <%= link_to question.title, question_path(question) %>
    </div>
  <% end %>

  <div class="question-body-preview">
    <%= question.body %>
  </div>

  <% if question.tags_list.any? %>
    <div class="tags-row">
      <% question.tags_list.each do |tag| %>
        <span class="tag-pill"
              style="color: <%= tag_color(tag) %>; border-color: <%= tag_color(tag) %>;">
          #<%= tag %>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="question-card-footer">
    <button class="btn-action">
      <%= fa_icon "thumbs-up" %> Like
    </button>
    <button class="btn-action">
      <%= fa_icon "comment-o" %> <%= question.id % 17 %>
    </button>
    <button class="btn-action">
      <%= fa_icon "share-alt" %>
    </button>
  </div>
</div>
