<div style="max-width: 420px; margin: 40px auto;">
  <div class="card">
    <h2 class="title-md" style="margin-bottom: 20px;">Join Askly</h2>

    <% if @user.errors.any? %>
      <div style="margin-bottom: 16px;">
        <% @user.errors.full_messages.each do |message| %>
          <p class="form-error">• <%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @user, data: { turbo: false } do |form| %>
      <div class="form-group">
        <%= form.label :name, "Name", class: "form-label" %>
        <%= form.text_field :name, class: "form-input", placeholder: "Your full name" %>
      </div>

      <div class="form-group">
        <%= form.label :nickname, "Nickname", class: "form-label" %>
        <%= form.text_field :nickname, class: "form-input", placeholder: "@nickname" %>
      </div>

      <div class="form-group">
        <%= form.label :email, "Email", class: "form-label" %>
        <%= form.text_field :email, class: "form-input", placeholder: "you@example.com" %>
      </div>

      <div class="form-group">
        <%= form.label :password, "Password", class: "form-label" %>
        <%= form.password_field :password, class: "form-input", placeholder: "••••••••" %>
      </div>

      <div class="form-group">
        <%= form.label :password_confirmation, "Confirm Password", class: "form-label" %>
        <%= form.password_field :password_confirmation, class: "form-input", placeholder: "••••••••" %>
      </div>

      <div style="margin-top: 20px;">
        <%= form.submit "Join", class: "btn-publish" %>
      </div>
    <% end %>

    <p class="text-muted text-sm" style="margin-top:16px; text-align:center;">
      Already have an account? <%= link_to "Sign in", new_session_path %>
    </p>
  </div>
</div>
